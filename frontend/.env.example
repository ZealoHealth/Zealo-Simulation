# API base URL. Point this at the Render backend in production.
VITE_API_BASE_URL=http://localhost:8000

# Map tiles. Standard OpenStreetMap tiles by default. Made configurable so the
# provider can be swapped without a code change if traffic outgrows the OSM tile
# usage policy. Attribution is required whatever the provider.
VITE_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
